<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network, no camera, no eye tracking (design container.permissions); hand tracking lists no runtime permission. -->

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BandageWrapTheme"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.BandageWrapTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DefaultStage: design container STAGE_MIXED (Full Space, passthrough). -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="BandageWrapStage" />

            <!-- "1": StageStyle.Mixed: the arm on your real desk, at real scale (design container STAGE_MIXED) -->
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />

            <!-- 2 = real upper limbs hidden: the bandage draws over the passthrough arms (design upperLimbRenderMode Hidden) -->
            <meta-data
                android:name="pico.spatial.stage.upperlimb"
                android:value="2" />
            <meta-data
                android:name="pico.spatial.stage.immersion"
                android:value="100" />
            <meta-data
                android:name="pico.spatial.stage.immersion_min"
                android:value="100" />
            <meta-data
                android:name="pico.spatial.stage.immersion_max"
                android:value="100" />

        </activity>
    </application>

</manifest>
